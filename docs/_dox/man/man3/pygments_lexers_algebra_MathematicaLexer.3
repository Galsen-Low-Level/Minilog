.SS "dict pygments\&.lexers\&.algebra\&.MathematicaLexer\&.tokens\fC [static]\fP"
\fBInitial value:\fP.PP
.nf
=  {
        'root': [
            (r'(?s)\\(\\*\&.*?\\*\\)', Comment),

            (r'([a\-zA\-Z]+[A\-Za\-z0\-9]*`)', Name\&.Namespace),
            (r'([A\-Za\-z0\-9]*_+[A\-Za\-z0\-9]*)', Name\&.Variable),
            (r'#\\d*', Name\&.Variable),
            (r'([a\-zA\-Z]+[a\-zA\-Z0\-9]*)', Name),

            (r'\-?\\d+\\\&.\\d*', Number\&.Float),
            (r'\-?\\d*\\\&.\\d+', Number\&.Float),
            (r'\-?\\d+', Number\&.Integer),

            (words(operators), Operator),
            (words(punctuation), Punctuation),
            (r'"\&.*?"', String),
            (r'\\s+', Text\&.Whitespace),
        ],
    }
.fi


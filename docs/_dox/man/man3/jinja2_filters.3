.SS " str jinja2\&.filters\&.do_urlize ('EvalContext' eval_ctx, str value, t\&.Optional[int]  trim_url_limit = \fCNone\fP, bool  nofollow = \fCFalse\fP, t\&.Optional[str]  target = \fCNone\fP, t\&.Optional[str]  rel = \fCNone\fP, t\&.Optional[t\&.Iterable[str]]  extra_schemes = \fCNone\fP)"

.PP
.nf

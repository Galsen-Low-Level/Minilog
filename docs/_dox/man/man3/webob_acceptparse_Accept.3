.SS "tuple webob\&.acceptparse\&.Accept\&.media_range_re\fC [static]\fP"
\fBInitial value:\fP.PP
.nf
=  (
        '(' +
        '(?:' + type_re + '/' + subtype_re + ')' +
        # '*' is included through type_re and subtype_re, so this covers */*
        # and type/*
        ')' +
        '(' +
        '(?:' + OWS_re + ';' + OWS_re +
        '(?![qQ]=)' +  # media type parameter cannot be named "q"
        parameter_re + ')*' +
        ')'
    )
.fi


marker_item = WS? marker_var WS? marker_op WS? marker_var WS?

.fi
.PP
 
.SS " \fBOp\fP pip\&._vendor\&.packaging\&._parser\&._parse_marker_op (\fBTokenizer\fP tokenizer)\fC [protected]\fP"

.PP
.nf
marker_op = IN | NOT IN | OP

.fi
.PP
 
.SS " \fBMarkerVar\fP pip\&._vendor\&.packaging\&._parser\&._parse_marker_var (\fBTokenizer\fP tokenizer)\fC [protected]\fP"

.PP

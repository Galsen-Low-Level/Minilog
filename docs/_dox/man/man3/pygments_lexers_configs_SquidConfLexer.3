        "proxy\-only", "weight", "ttl", "no\-query", "default", "round\-robin",
        "multicast\-responder", "on", "off", "all", "deny", "allow", "via",
        "parent", "no\-digest", "heap", "lru", "realm", "children", "q1", "q2",
        "credentialsttl", "none", "disable", "offline_toggle", "diskd",
    )

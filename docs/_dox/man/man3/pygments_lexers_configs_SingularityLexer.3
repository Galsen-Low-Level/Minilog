.nf
=  {
        'root': [
            (_section, bygroups(Generic\&.Heading, Whitespace), 'script'),
            (_appsect, bygroups(Generic\&.Heading, Whitespace), 'script'),
            (_headers, bygroups(Whitespace, Keyword, Text)),
            (r'\\s*#\&.*?\\n', Comment),
            (r'\\b(([0\-9]+\\\&.?[0\-9]*)|(\\\&.[0\-9]+))\\b', Number),
            (r'[ \\t]+', Whitespace),
            (r'(?!^\\s*%)\&.', Text),
        ],
        'script': [
            (r'(\&.+?(?=^\\s*%))|(\&.*)', using(BashLexer), '#pop'),
        ],
    }

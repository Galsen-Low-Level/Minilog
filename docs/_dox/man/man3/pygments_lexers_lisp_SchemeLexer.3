.SS "str pygments\&.lexers\&.lisp\&.SchemeLexer\&.complex_\fC [static]\fP"
\fBInitial value:\fP.PP
.nf
=  rf'''
          (
            {real}?  [+\-]  ({naninf}|{ureal})?  i
            | {real} (@ {real})?

          )
        '''
.fi

.SS "str pygments\&.lexers\&.lisp\&.SchemeLexer\&.decimal\fC [static]\fP"
\fBInitial value:\fP.PP
.nf
=  r'''
              (
                # Decimal part
                (
                  [0\-9]+ ([\&.][0\-9]*)?
                  | [\&.][0\-9]+
                )

                # Optional exponent
                (
                  [eEsSfFdDlL] [+\-]? [0\-9]+
                )?

                # Optional mantissa width
                (
                  \\|[0\-9]+
                )?
              )
            '''
.fi

.SS "str pygments\&.lexers\&.lisp\&.SchemeLexer\&.digit = r'[01]'\fC [static]\fP"

.SS "list pygments\&.lexers\&.lisp\&.SchemeLexer\&.filenames = ['*\&.scm', '*\&.ss']\fC [static]\fP"

.SS "pygments\&.lexers\&.lisp\&.SchemeLexer\&.flags = re\&.DOTALL | re\&.MULTILINE\fC [static]\fP"

.SS "list pygments\&.lexers\&.lisp\&.SchemeLexer\&.mimetypes = ['text/x\-scheme', 'application/x\-scheme']\fC [static]\fP"

.SS "str pygments\&.lexers\&.lisp\&.SchemeLexer\&.name = 'Scheme'\fC [static]\fP"

.SS "str pygments\&.lexers\&.lisp\&.SchemeLexer\&.naninf = r'(nan\&.0|inf\&.0)'\fC [static]\fP"

.SS "str pygments\&.lexers\&.lisp\&.SchemeLexer\&.num\fC [static]\fP"
\fBInitial value:\fP.PP
.nf
=  rf'''(?x)
          (
            {prefix}
            {complex_}
          )
          # Need to ensure we have a full token\&. 1+ is not a
          # number followed by something else, but a function
          # name\&.
          {token_end}
        '''
.fi

.SS "dict pygments\&.lexers\&.lisp\&.SchemeLexer\&.number_rules = {}\fC [static]\fP"

.SS "str pygments\&.lexers\&.lisp\&.SchemeLexer\&.prefix\fC [static]\fP"
\fBInitial value:\fP.PP
.nf
=  rf'''
          (
            {radix} (\\#[iIeE])?
            | \\#[iIeE] {radix}
          )
        '''
.fi

.SS "str pygments\&.lexers\&.lisp\&.SchemeLexer\&.radix = r'( \\#[bB] )'\fC [static]\fP"

.SS "str pygments\&.lexers\&.lisp\&.SchemeLexer\&.real\fC [static]\fP"
\fBInitial value:\fP.PP
.nf
=  rf'''
          (
            [+\-] {naninf}  # Sign mandatory
            | [+\-]? {ureal}    # Sign optional
          )
        '''
.fi

.SS "str pygments\&.lexers\&.lisp\&.SchemeLexer\&.token_end\fC [static]\fP"
\fBInitial value:\fP.PP
.nf
=  r'''
      (?=
        \\s         # whitespace
        | ;        # comment
        | \\#[;|!] # fancy comments
        | [)\\]]    # end delimiters
        | $        # end of file
      )
    '''
.fi

.SS "str pygments\&.lexers\&.lisp\&.SchemeLexer\&.ureal\fC [static]\fP"
\fBInitial value:\fP.PP
.nf
=  rf'''
          (
            {digit}+
            ( / {digit}+ )?
          )
        '''
.fi


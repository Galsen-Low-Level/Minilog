=  """\\
% Linux Libertine (free, wide coverage, not only for Linux)
\\\\setmainfont{Linux Libertine O}
\\\\setsansfont{Linux Biolinum O}
\\\\setmonofont[HyphenChar=None,Scale=MatchLowercase]{DejaVu Sans Mono}"""
.fi


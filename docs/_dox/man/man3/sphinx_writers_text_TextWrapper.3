.SS "sphinx\&.writers\&.text\&.TextWrapper\&.wordsep_re\fC [static]\fP"
\fBInitial value:\fP.PP
.nf
=  re\&.compile(
        r'(\\s+|'                                  # any whitespace
        r'(?<=\\s)(?::[a\-z\-]+:)?`\\S+|'             # interpreted text start
        r'[^\\s\\w]*\\w+[a\-zA\-Z]\-(?=\\w+[a\-zA\-Z])|'   # hyphenated words
        r'(?<=[\\w\\!\\"\\'\\&\\\&.\\,\\?])\-{2,}(?=\\w))'    # em\-dash
    )
.fi



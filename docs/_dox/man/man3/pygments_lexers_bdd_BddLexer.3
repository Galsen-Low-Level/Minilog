.fi

.SS "dict pygments\&.lexers\&.bdd\&.BddLexer\&.tokens\fC [static]\fP"
\fBInitial value:\fP.PP
.nf
=  {
        'comments': [
            (r'^\\s*#\&.*$', Comment),
        ],
        'miscellaneous': [
            (r'(<|>|\\[|\\]|=|\\||:|\\(|\\)|\\{|\\}|,|\\\&.|;|\-|_|\\$)', Punctuation),
            (r'((?<=\\<)[^\\\\>]+(?=\\>))', Name\&.Variable),
            (r'"([^\\"]*)"', String),
            (r'^@\\S+', Name\&.Label),
        ],
        'numbers': [
            (r'(\\d+\\\&.?\\d*|\\d*\\\&.\\d+)([eE][+\-]?[0\-9]+)?', Number),
        ],
        'root': [
            (r'\\n|\\s+', Whitespace),
            (step_keywords, Keyword),
            include('comments'),
            include('miscellaneous'),
            include('numbers'),
            (r'\\S+', Text),
        ]
    }
.fi


.SS "tuple pygments\&.lexers\&.esoteric\&.RedcodeLexer\&.opcodes\fC [static]\fP"
\fBInitial value:\fP.PP
.nf
=  ('DAT', 'MOV', 'ADD', 'SUB', 'MUL', 'DIV', 'MOD',
               'JMP', 'JMZ', 'JMN', 'DJN', 'CMP', 'SLT', 'SPL',
               'ORG', 'EQU', 'END')
.fi

.SS "dict pygments\&.lexers\&.esoteric\&.RedcodeLexer\&.tokens\fC [static]\fP"
\fBInitial value:\fP.PP
.nf
=  {
        'root': [
            # Whitespace:
            (r'\\s+', Whitespace),
            (r';\&.*$', Comment\&.Single),
            # Lexemes:
            #  Identifiers
            (r'\\b({})\\b'\&.format('|'\&.join(opcodes)), Name\&.Function),
            (r'\\b({})\\b'\&.format('|'\&.join(modifiers)), Name\&.Decorator),
            (r'[A\-Za\-z_]\\w+', Name),
            #  Operators
            (r'[\-+*/%]', Operator),
            (r'[#$@<>]', Operator),  # mode
            (r'[\&.,]', Punctuation),  # mode
            #  Numbers
            (r'[\-+]?\\d+', Number\&.Integer),
        ],
    }
.fi


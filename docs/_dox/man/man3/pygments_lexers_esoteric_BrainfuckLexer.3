\fBInitial value:\fP.PP
.nf
=  {
        'common': [
            # use different colors for different instruction types
            (r'[\&.,]+', Name\&.Tag),
            (r'[+\-]+', Name\&.Builtin),
            (r'[<>]+', Name\&.Variable),
            (r'[^\&.,+\\\-<>\\[\\]]+', Comment),
        ],
        'root': [
            (r'\\[', Keyword, 'loop'),
            (r'\\]', Error),
            include('common'),
        ],
        'loop': [
            (r'\\[', Keyword, '#push'),
            (r'\\]', Keyword, '#pop'),
            include('common'),
        ]
    }
.fi


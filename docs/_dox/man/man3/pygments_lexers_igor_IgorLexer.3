.SS "dict pygments\&.lexers\&.igor\&.IgorLexer\&.tokens\fC [static]\fP"
\fBInitial value:\fP.PP
.nf
=  {
        'root': [
            (r'//\&.*$', Comment\&.Single),
            (r'"([^"\\\\]|\\\\\&.)*"', String),
            # Flow Control\&.
            (words(flowControl, prefix=r'\\b', suffix=r'\\b'), Keyword),
            # Types\&.
            (words(types, prefix=r'\\b', suffix=r'\\b'), Keyword\&.Type),
            # Keywords\&.
            (words(keywords, prefix=r'\\b', suffix=r'\\b'), Keyword\&.Reserved),
            # Built\-in operations\&.
            (words(operations, prefix=r'\\b', suffix=r'\\b'), Name\&.Class),
            # Built\-in functions\&.
            (words(functions, prefix=r'\\b', suffix=r'\\b'), Name\&.Function),
            # Compiler directives\&.
            (r'^#(include|pragma|define|undef|ifdef|ifndef|if|elif|else|endif)',
             Name\&.Decorator),
            (r'\\s+', Whitespace),
            (r'[^a\-z"/]+$', Text),
            (r'\&.', Text),
        ],
    }
.fi


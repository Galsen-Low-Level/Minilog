        "\&.align", "\&.ascii", "\&.asciiz", "\&.byte", "\&.data", "\&.double", "\&.extern", "\&.float",
        "\&.globl", "\&.half", "\&.kdata", "\&.ktext", "\&.space", "\&.text", "\&.word",
    ]
.fi

.SS "list pygments\&.lexers\&.mips\&.MIPSLexer\&.filenames = ['*\&.mips', '*\&.MIPS']\fC [static]\fP"

.SS "list pygments\&.lexers\&.mips\&.MIPSLexer\&.keywords\fC [static]\fP"


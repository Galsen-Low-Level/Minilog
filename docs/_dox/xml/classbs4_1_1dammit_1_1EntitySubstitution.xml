      <memberdef kind="function" id="classbs4_1_1dammit_1_1EntitySubstitution_1af21ed0fc47f2bd2e7fb4f981b3a2aefb" prot="protected" static="no" const="no" explicit="no" inline="no" virt="non-virtual">

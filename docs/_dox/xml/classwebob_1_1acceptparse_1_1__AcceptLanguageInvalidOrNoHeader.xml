        <argsstring>(self, language_tags=None, default_range=None, default_tag=None, default=None)</argsstring>
        <name>lookup</name>
        <qualifiedname>webob.acceptparse._AcceptLanguageInvalidOrNoHeader.lookup</qualifiedname>

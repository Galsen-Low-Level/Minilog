      <memberdef kind="function" id="classwebob_1_1acceptparse_1_1AcceptValidHeader_1a133a2f8379946a9f5dde9ac59e432eb9" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type></type>

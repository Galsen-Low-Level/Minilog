&lt;SpecifierSet(&apos;!=2.0.0,&gt;=1.0.0&apos;, prereleases=False)&gt;
&gt;&gt;&gt; SpecifierSet(&apos;&gt;=1.0.0,!=2.0.0&apos;, prereleases=True)
&lt;SpecifierSet(&apos;!=2.0.0,&gt;=1.0.0&apos;, prereleases=True)&gt;
</verbatim> </para>

    warnings.filterwarnings(&quot;ignore&quot;, category=<ref refid="classbs4_1_1__warnings_1_1MarkupResemblesLocatorWarning" kindref="compound">MarkupResemblesLocatorWarning</ref>)
    &quot;&quot;&quot;</initializer>

      <memberdef kind="variable" id="namespacepip_1_1__vendor_1_1packaging_1_1version_1a6fc7d5e3de2d81a13aad2263879df22a" prot="protected" static="no" mutable="no">
        <type>str</type>
        <definition>str pip::_vendor::packaging::version._VERSION_PATTERN</definition>
        <argsstring></argsstring>
        <name>_VERSION_PATTERN</name>
        <qualifiedname>pip._vendor.packaging.version._VERSION_PATTERN</qualifiedname>
        <initializer>=  r&quot;&quot;&quot;
    v?
    (?:
        (?:(?P&lt;epoch&gt;[0-9]+)!)?                           # epoch
        (?P&lt;release&gt;[0-9]+(?:\.[0-9]+)*)                  # release segment
        (?P&lt;pre&gt;                                          # pre-release
            [-_\.]?
            (?P&lt;pre_l&gt;alpha|a|beta|b|preview|pre|c|rc)
            [-_\.]?
            (?P&lt;pre_n&gt;[0-9]+)?
        )?
        (?P&lt;post&gt;                                         # post release
            (?:-(?P&lt;post_n1&gt;[0-9]+))
            |
            (?:
                [-_\.]?
                (?P&lt;post_l&gt;post|rev|r)
                [-_\.]?
                (?P&lt;post_n2&gt;[0-9]+)?
            )
        )?
        (?P&lt;dev&gt;                                          # dev release
            [-_\.]?
            (?P&lt;dev_l&gt;dev)
            [-_\.]?
            (?P&lt;dev_n&gt;[0-9]+)?
        )?
    )
    (?:\+(?P&lt;local&gt;[a-z0-9]+(?:[-_\.][a-z0-9]+)*))?       # local version
&quot;&quot;&quot;</initializer>

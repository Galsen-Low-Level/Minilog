      <memberdef kind="function" id="classwebob_1_1acceptparse_1_1__AcceptCharsetInvalidOrNoHeader_1a7f22bd9391ba6cfb048e56d1ee162041" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">

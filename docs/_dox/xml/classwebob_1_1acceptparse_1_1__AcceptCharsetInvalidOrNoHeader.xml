      <memberdef kind="function" id="classwebob_1_1acceptparse_1_1__AcceptCharsetInvalidOrNoHeader_1a8a2e4630154507789ea0002bc2465bf1" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
